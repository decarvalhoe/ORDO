#!/usr/bin/env bash
# ORDO token template. Never commit real values.
# Copy to an operator-controlled path, chmod 600, then source it before running
# workflows that need privileged provider operations.

# Provider admin token with the minimum scopes required for the configured
# repository and branch-protection policy.
export GH_ADMIN_TOKEN=ghp_REPLACE_ME

# Optional per-agent provider tokens.
# export GH_TOKEN_AGENT_planner=ghp_REPLACE_ME
# export GH_TOKEN_AGENT_builder=ghp_REPLACE_ME
