#!/usr/bin/env bash
# orch-tokens.env — admin tokens for orch-toolkit (NEVER commit).
# Place at /root/.config/orch-tokens.env, chmod 600, then:
#   source /root/.config/orch-tokens.env
#
# pr_merge.sh will source this automatically when tier 3 (--admin) is needed.

# GitHub admin PAT with 'repo' + 'admin:org' (for branch protection bypass)
# Create at: https://github.com/settings/tokens
export GH_ADMIN_TOKEN=ghp_REPLACE_ME

# Optional: per-agent PATs (used by dispatch_ticket.sh to gh issue --add-assignee)
# export GH_TOKEN_RBOKCLIclaude=ghp_...
# export GH_TOKEN_RBOKCLIcursor=ghp_...
