{
  "schema_version": "1",
  "name": "process_crash",
  "description": "Process crash injection (ORDO_JOURNAL_FAULT=kill_before_commit): the bridge dies between the provider mutation and the approval consumption, then the scheduler dies on run.succeeded. Replaying both steps executes the mutation exactly once and completes the run.",
  "clock": "2026-09-11T10:00:00Z",
  "repo": "acme/widgets",
  "operator": "eric",
  "policy": {"external_mutations": "pr_merge", "principals": "eric=pr.merge", "policy_version": "policy-v1"},
  "runs": [
    {"alias": "merge12", "title": "Merge PR 12", "ticket": "acme/widgets#12"}
  ],
  "steps": [
    {"op": "tick", "expect": {"run": "merge12", "state": "running"}},
    {"op": "provider", "run": "merge12", "args": ["pr_get", "12"]},
    {"op": "require_approval", "run": "merge12", "action": "pr.merge", "expect": {"state": "approval_required"}},
    {"op": "approval_request", "run": "merge12", "ref": "merge", "action": "pr.merge", "principal": "eric", "key": "merge-acme-widgets-12", "ttl": 900, "args": ["12", "--method", "squash"]},
    {"op": "grant", "approval": "merge", "by": "eric"},
    {"op": "crash", "label": "die after the merge, before the approval is consumed", "at": "approval_consume",
     "during": {"op": "execute", "approval": "merge", "args": ["pr_merge", "12", "--method", "squash"], "by": "eric"}},
    {"op": "execute", "label": "replay: the ledger answers, nothing merges twice", "approval": "merge", "args": ["pr_merge", "12", "--method", "squash"], "by": "eric", "expect": {"replayed": "true"}},
    {"op": "resume", "run": "merge12", "expect": {"state": "running"}},
    {"op": "advance", "seconds": 30},
    {"op": "crash", "label": "die inside run.succeeded", "at": "first_write",
     "during": {"op": "complete", "run": "merge12", "result": {"merged": 12}}},
    {"op": "complete", "run": "merge12", "result": {"merged": 12}, "expect": {"state": "succeeded"}}
  ]
}
